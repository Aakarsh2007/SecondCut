# Optional generic local environment template.
# For the Cloudflare Worker, copy .dev.vars.example to .dev.vars instead.
# Do not prefix secrets with VITE_; VITE_* values can be exposed to browser code.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_FREE_TIER_CONFIRMED=false

PAYPAL_INBOX_ORIGIN=
PAYPAL_INBOX_SYNC_KEY=
