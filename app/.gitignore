# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Local environment and keys
# Keep only non-secret templates under version control.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.p12
*.pfx
*.crt

# Sensitive local exports and evidence. Public, reviewed documentation belongs in docs/.
*.private.json
*.private.md
*.private.csv
*.private.log
/private/
/secrets/

# Checkout-local tool state
/.wrangler/
/.sites-runtime/
/.cache/
/.turbo/
/.vercel/
.eslintcache

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/
/tmp/

# OS metadata
.DS_Store
